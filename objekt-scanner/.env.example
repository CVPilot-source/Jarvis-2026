# Kopieren nach .env und ausfüllen:  cp .env.example .env

FIRMA_NAME=Muster Gebäudereinigung GmbH
# Adresse, unter der die App erreichbar ist (für die QR-Codes)
PUBLIC_URL=https://scan.deine-domain.de

# Passwort für den Admin-Bereich (lang und sicher wählen!)
ADMIN_PASSWORD=bitte-aendern
# Zufälliger Schlüssel:  python3 -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=bitte-aendern

# Standard-Empfänger (wenn beim Objekt keine eigene E-Mail eingetragen ist)
MAIL_TO=kundenbetreuung@deine-firma.de

# SMTP (z. B. Firmen-Postfach, Microsoft 365, IONOS, Strato ...)
SMTP_HOST=smtp.office365.com
SMTP_PORT=587
SMTP_SSL=0
SMTP_USER=scanner@deine-firma.de
SMTP_PASS=
SMTP_FROM=scanner@deine-firma.de

# PDFs nach so vielen Tagen automatisch löschen (DSGVO)
RETENTION_DAYS=365

# Port, auf dem die App intern läuft (nginx leitet weiter)
PORT=5050
